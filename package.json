{
  "name": "herdy",
  "version": "0.1.0",
  "description": "CLI tool to manage multi-service local development environments",
  "type": "module",
  "bin": {
    "herdy": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "microservices",
    "devtools",
    "cli",
    "monorepo",
    "service-manager"
  ],
  "author": "Cloud Soh <cloudsoh03021@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.3.0",
    "tree-kill": "^1.2.2",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}